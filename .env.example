# ===== 服务端变量（配置在 Netlify/Vercel 的 Environment Variables，绝不进前端包）=====
# Notion 集成令牌。注意: 曾经以 VITE_NOTION_TOKEN 形式泄露在前端产物中,
# 部署本版本前请先到 Notion 后台轮换 (Settings → Connections → 重新生成)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxx

# 服务端代理的白名单校验用（与下方 VITE_ 同值即可）
NOTION_DATABASE_ANNIVERSARY=xxxxxxxxxxxxxxxx
NOTION_DATABASE_PHOTOS=xxxxxxxxxxxxxxxx
NOTION_DATABASE_TIMELINE=xxxxxxxxxxxxxxxx
NOTION_DATABASE_MESSAGES=xxxxxxxxxxxxxxxx
NOTION_DATABASE_WISHES=xxxxxxxxxxxxxxxx

# 代理允许的额外跨域来源（逗号分隔, 默认已含本站与 localhost）
# ALLOWED_ORIGINS=https://zhuzhu-site.vercel.app

# ===== 前端变量（Vite 打包进浏览器, 仅含公开信息: 数据库 ID, 无 token）=====
VITE_NOTION_DATABASE_ANNIVERSARY=xxxxxxxxxxxxxxxx
VITE_NOTION_DATABASE_PHOTOS=xxxxxxxxxxxxxxxx
VITE_NOTION_DATABASE_TIMELINE=xxxxxxxxxxxxxxxx
VITE_NOTION_DATABASE_MESSAGES=xxxxxxxxxxxxxxxx
VITE_NOTION_DATABASE_WISHES=xxxxxxxxxxxxxxxx
